// Base build configuration for the Hana app target.
//
// Real API keys are NOT stored here and are not in version control.
// They live in Config/Secrets.xcconfig, which is listed in .gitignore.
//
// Setup: copy Config/Secrets.example.xcconfig to Config/Secrets.xcconfig
// and fill in your own keys. See the README for where to get each one.
//
// The empty defaults below keep a fresh clone building even with no keys
// configured; the network calls that need them will simply fail.

PLANT_ID_API_KEY =
AIXPLAIN_TEAM_API_KEY =
POSTHOG_API_KEY =

// Optional include: the "?" means the build does not break when the file
// is absent, which is the case for any clone that has not been set up yet.
#include? "Secrets.xcconfig"
